<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-to-device transfer rules. Nothing of Findr's leaves the phone in a backup or a phone-to-phone
  move: the index holds the text of the user's files, and the settings name folders they excluded or marked private.
  On Android 12+, android:allowBackup="false" stops cloud backup but not device-to-device transfer, so these rules are what
  stop the transfer. Every domain is excluded, credential-encrypted (root, file, database, sharedpref, external) and
  device-encrypted (device_*) alike. A <exclude> with no path covers the whole domain. BackupRulesTest checks this file.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
    <exclude domain="device_root" />
    <exclude domain="device_file" />
    <exclude domain="device_database" />
    <exclude domain="device_sharedpref" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
    <exclude domain="device_root" />
    <exclude domain="device_file" />
    <exclude domain="device_database" />
    <exclude domain="device_sharedpref" />
  </device-transfer>
</data-extraction-rules>
